FROM node:22-slim AS frontend
WORKDIR /web
COPY web/package.json web/package-lock.json ./
RUN npm ci
COPY web/ ./
ENV NEXT_TELEMETRY_DISABLED=1
RUN npm run build

FROM python:3.12-slim AS python-builder
WORKDIR /app
COPY requirements.txt requirements-web.txt ./
RUN pip install --no-cache-dir --prefix=/install -r requirements-web.txt

FROM python:3.12-slim
WORKDIR /app
COPY --from=python-builder /install /usr/local
COPY bot/ ./bot/
COPY api/ ./api/
COPY --from=frontend /web/out/ ./web/out/
RUN chmod -R a+rX /app && useradd --uid 10001 --create-home mone
USER mone
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1
EXPOSE 8000
CMD ["uvicorn", "api.main:create_app", "--factory", "--host", "0.0.0.0", "--port", "8000"]
